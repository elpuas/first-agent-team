# OpenAI model access. Never commit the real key.
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-6-luna

# Figma's remote MCP endpoint uses OAuth. A bearer access token is required by
# this first, non-interactive checker. Do not paste the token into logs.
FIGMA_MCP_URL=https://mcp.figma.com/mcp
FIGMA_MCP_ACCESS_TOKEN=replace_with_figma_oauth_access_token

# Keep the browser restricted to the local preview used by the assignment.
PLAYWRIGHT_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
